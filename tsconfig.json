{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "lib": ["DOM", "DOM.Iterable", "ES2021"],
    "types": ["node"]
  },
  "include": ["main.ts", "src/**/*.ts", "tests/**/*.ts"]
}
